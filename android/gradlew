#!/bin/sh
# Minimal Gradle wrapper launcher. gradle-wrapper.jar is generated by Flutter/Gradle tooling.
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" >/dev/null && pwd -P)
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$CLASSPATH" ]; then
  echo "Missing gradle-wrapper.jar. Run 'flutter create --platforms=android .' once with a Flutter SDK to regenerate platform wrapper files." >&2
  exit 1
fi
exec "${JAVA_HOME:+$JAVA_HOME/bin/}java" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
